index 00000000..d6eb5d56
--- /dev/null
+++ b/Sources/Vorssaint/Services/Display/DisplayArrangementSupport.swift
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Chlcony
+
+import Foundation
+
+/// One display's place in a saved arrangement. Positions are CoreGraphics
+/// global coordinates, where the main display — the one carrying the menu bar
+/// — is by definition at the origin. Storing the origins therefore captures
+/// both the spatial layout and which display is main, with nothing extra.
+///
+/// The key is the display's UUID rather than its `CGDirectDisplayID`: ids are
+/// reassigned across reconnection and reboots, so a preset keyed by one would
+/// silently start pointing at the wrong monitor.
+struct DisplaySlot: Codable, Equatable, Identifiable {
+    let key: String
+    /// The display's name when the preset was saved, kept so a preset can say
+    /// which monitor it is waiting for while that monitor is unplugged.
+    let name: String
+    let x: Int
+    let y: Int
+    let width: Int
+    let height: Int
+
+    var id: String { key }
+    var isMain: Bool { x == 0 && y == 0 }
+}
+
+struct DisplayArrangementPreset: Codable, Equatable, Identifiable {
+    let id: UUID
+    var slots: [DisplaySlot]
+
+    init(id: UUID = UUID(), slots: [DisplaySlot]) {
+        self.id = id
+        self.slots = DisplayArrangementSupport.normalized(slots)
+    }
+
+    var keys: Set<String> { Set(slots.map(\.key)) }
+}
+
+/// Everything about arrangements that can be decided without touching
+/// CoreGraphics or AppKit, so it can be exercised by the test suite.
+enum DisplayArrangementSupport {
+    /// The strip is a row of small thumbnails in a 308pt panel, not a list.
+    /// Past this many it stops being something you can pick from at a glance.
+    static let maximumPresets = 10
+
+    /// Where a display sits relative to the main one. The UI turns this into
+    /// the preset's tooltip; keeping the decision here keeps this file free of
+    /// localized text.
+    enum Relation {
+        case left, right, above, below, overlapping
+    }
+
+    struct Box: Equatable {
+        var minX: Double
+        var minY: Double
+        var width: Double
+        var height: Double
+    }
+
+    /// Slots in a stable order so two captures of the same layout compare
+    /// equal whatever order the system listed the displays in.
+    static func normalized(_ slots: [DisplaySlot]) -> [DisplaySlot] {
+        slots.sorted { $0.key < $1.key }
+    }
+
+    /// The same displays, shifted so the arrangement's top-left corner is the
+    /// origin.
+    ///
+    /// This is what makes an arrangement a *shape* rather than a position. In
+    /// CoreGraphics the main display is whichever one is at (0,0), so two
+    /// captures of physically identical screens differ by a translation as soon
+    /// as the menu bar moves between them. Canonicalizing removes that
+    /// translation, so moving the menu bar is not mistaken for rearranging the
+    /// desk.
+    static func canonical(_ slots: [DisplaySlot]) -> [DisplaySlot] {
+        guard let box = boundingBox(slots) else { return normalized(slots) }
+        return translated(slots, byX: -Int(box.minX), y: -Int(box.minY)) ?? normalized(slots)
+    }
+
+    private static func translated(_ slots: [DisplaySlot], byX dx: Int, y dy: Int) -> [DisplaySlot]? {
+        let moved = slots.map {
+            DisplaySlot(key: $0.key, name: $0.name,
+                        x: $0.x + dx, y: $0.y + dy,
+                        width: $0.width, height: $0.height)
+        }
+        guard moved.allSatisfy(isPlaceable) else { return nil }
+        return normalized(moved)
+    }
+
+    /// Whether two captures describe the same physical arrangement. Two things
+    /// are deliberately excluded: a monitor renamed in System Settings is still
+    /// the same monitor in the same place, and which display holds the menu bar
+    /// is a separate choice from where the screens sit.
+    static func sameLayout(_ lhs: [DisplaySlot], _ rhs: [DisplaySlot]) -> Bool {
+        let left = canonical(lhs)
+        let right = canonical(rhs)
+        guard left.count == right.count else { return false }
+        return zip(left, right).allSatisfy {
+            $0.key == $1.key && $0.x == $1.x && $0.y == $1.y
+        }
+    }
+
+    /// A preset can only be applied when every display it names is connected.
+    static func matches(_ preset: DisplayArrangementPreset, connected: Set<String>) -> Bool {
+        preset.keys.isSubset(of: connected)
+    }
+
+    /// The names of the displays a preset is waiting for, in saved order.
+    static func missingDisplayNames(_ preset: DisplayArrangementPreset,
+                                    connected: Set<String>) -> [String] {
+        preset.slots.filter { !connected.contains($0.key) }.map(\.name)
+    }
+
+    /// The preset describing the live layout, if any.
+    static func activePreset(in presets: [DisplayArrangementPreset],
+                             current: [DisplaySlot]) -> UUID? {
+        presets.first { sameLayout($0.slots, current) }?.id
+    }
+
+    /// Whether this layout is already saved. Saving a second copy of an
+    /// arrangement that is already in the strip only makes the strip harder
+    /// to read.
+    static func duplicate(of slots: [DisplaySlot],
+                          in presets: [DisplayArrangementPreset]) -> UUID? {
+        presets.first { sameLayout($0.slots, slots) }?.id
+    }
+
+    /// The rectangle enclosing every display, used to scale a thumbnail.
+    static func boundingBox(_ slots: [DisplaySlot]) -> Box? {
+        guard let first = slots.first else { return nil }
+        var minX = Double(first.x)
+        var minY = Double(first.y)
+        var maxX = Double(first.x + first.width)
+        var maxY = Double(first.y + first.height)
+        for slot in slots.dropFirst() {
+            minX = min(minX, Double(slot.x))
+            minY = min(minY, Double(slot.y))
+            maxX = max(maxX, Double(slot.x + slot.width))
+            maxY = max(maxY, Double(slot.y + slot.height))
+        }
+        let width = maxX - minX
+        let height = maxY - minY
+        guard width > 0, height > 0 else { return nil }
+        return Box(minX: minX, minY: minY, width: width, height: height)
+    }
+
+    /// The main display of a saved arrangement: the one at the origin, or the
+    /// leftmost if a hand-edited preference left none there.
+    static func mainSlot(_ slots: [DisplaySlot]) -> DisplaySlot? {
+        slots.first(where: \.isMain) ?? slots.min { $0.x < $1.x }
+    }
+
+    /// Where `slot` sits relative to `main`. Vertical stacking wins ties only
+    /// when the horizontal overlap is larger than the vertical one, so a
+    /// display placed diagonally is described by its dominant direction.
+    static func relation(of slot: DisplaySlot, to main: DisplaySlot) -> Relation {
+        let horizontalOverlap = min(slot.x + slot.width, main.x + main.width) - max(slot.x, main.x)
+        let verticalOverlap = min(slot.y + slot.height, main.y + main.height) - max(slot.y, main.y)
+        if horizontalOverlap > 0 && verticalOverlap > 0 { return .overlapping }
+        if horizontalOverlap >= verticalOverlap {
+            return slot.y < main.y ? .above : .below
+        }
+        return slot.x < main.x ? .left : .right
+    }
+
+    /// The one display a preset is best described by: the first non-main slot
+    /// in saved order. Two-display arrangements — the case this feature is
+    /// built for — are then fully described by one relation.
+    static func describingSlot(_ preset: DisplayArrangementPreset) -> DisplaySlot? {
+        guard let main = mainSlot(preset.slots) else { return nil }
+        return preset.slots.first { $0.key != main.key }
+    }
+
+    /// CoreGraphics takes display origins as `Int32`. A preset is JSON on
+    /// disk, so nothing stops a hand-edited preference or a mangled settings
+    /// backup carrying a coordinate no display could have, and converting one
+    /// of those on the way to `CGConfigureDisplayOrigin` would trap rather
+    /// than fail. Such a preset is refused here instead, where the answer is
+    /// to drop it rather than to take the app down with it.
+    static func isPlaceable(_ slot: DisplaySlot) -> Bool {
+        let limits = Int(Int32.min)...Int(Int32.max)
+        return limits.contains(slot.x) && limits.contains(slot.y)
+            && slot.width > 0 && slot.height > 0
+    }
+
+    /// The same displays, shifted so `key` sits at the origin.
+    ///
+    /// macOS has no separate "main display" setting: the main display is
+    /// whichever one is at (0,0), and the menu bar follows it. So moving the
+    /// menu bar is a translation of the whole arrangement — every display
+    /// keeps its position relative to every other, and only the origin moves.
+    ///
+    /// Returns nil when the display is unknown, already main, or when the
+    /// translation would push a coordinate somewhere it cannot be applied.
+    static func slots(_ slots: [DisplaySlot], makingMain key: String) -> [DisplaySlot]? {
+        guard let target = slots.first(where: { $0.key == key }), !target.isMain else { return nil }
+        return self.slots(slots, keepingMain: key)
+    }
+
+    /// The same arrangement, positioned so `key` holds the menu bar.
+    ///
+    /// Applying a saved arrangement moves screens; which display is main is a
+    /// separate control with its own affordance, and a preset restoring the
+    /// menu bar to wherever it happened to be at save time would silently
+    /// undo that choice.
+    static func slots(_ slots: [DisplaySlot], keepingMain key: String) -> [DisplaySlot]? {
+        guard let anchor = slots.first(where: { $0.key == key }) else { return nil }
+        return translated(slots, byX: -anchor.x, y: -anchor.y)
+    }
+
+    static func decode(_ data: Data?) -> [DisplayArrangementPreset] {
+        guard let data, !data.isEmpty else { return [] }
+        guard let presets = try? JSONDecoder().decode([DisplayArrangementPreset].self, from: data)
+        else { return [] }
+        // A preset with fewer than two displays cannot describe an
+        // arrangement, one carrying an unplaceable slot cannot be applied, and
+        // one over the cap would not fit the strip. All three can only come
+        // from a preference nobody in this app wrote.
+        let usable = presets.filter { $0.slots.count > 1 && $0.slots.allSatisfy(isPlaceable) }
+        return Array(usable.prefix(maximumPresets))
+    }
+
+    static func encode(_ presets: [DisplayArrangementPreset]) -> Data? {
+        try? JSONEncoder().encode(presets)
+    }
+}
diff --git a/Sources/Vorssaint/UI/MenuPanel/ArrangementStrip.swift b/Sources/Vorssaint/UI/MenuPanel/ArrangementStrip.swift
new file mode 100644
index 00000000..9bf7dbd4
--- /dev/null
+++ b/Sources/Vorssaint/UI/MenuPanel/ArrangementStrip.swift
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Chlcony
+
+import SwiftUI
+
+/// Saved display arrangements, at the top of the Displays section: one small
+/// picture of each layout, click to switch. The strip carries no text because
+/// the shape is the label; the names live in the tooltips and the
+/// accessibility labels, where a description is worth more than a caption.
+struct ArrangementStrip: View {
+    @ObservedObject private var l10n = L10n.shared
+    @ObservedObject private var service = DisplayArrangementService.shared
+    @Environment(\.colorScheme) private var colorScheme
+    @Environment(\.notchPresentation) private var notchPresentation
+    let editing: Bool
+
+    /// Thumbnail plus its padding. The grid fits as many of these per row as
+    /// the surface allows, which differs between the menu bar panel and a
+    /// Dynamic Island the user can size down to 360pt.
+    private let slotWidth: CGFloat = 50
+
+    private var strings: DisplayArrangementStrings {
+        FeatureStrings.displayArrangement(l10n.language)
+    }
+
+    @ViewBuilder
+    var body: some View {
+        // Nothing to show until a second display is connected, and nothing to
+        // show in normal mode until something is saved, so the section looks
+        // exactly as it did before anyone uses this.
+        if service.isUsable, editing || !service.presets.isEmpty {
+            VStack(alignment: .leading, spacing: 7) {
+                if editing { saveButton }
+                if !service.presets.isEmpty { grid }
+                if let failure = service.failure { failureText(failure) }
+                Divider()
+            }
+            .onAppear {
+                service.refresh()
+                // A failure from an earlier visit has had its answer; carrying
+                // it into a fresh panel would describe a problem that may be
+                // long gone.
+                service.clearFailure()
+            }
+            .onChange(of: editing) { _, _ in service.clearFailure() }
+        }
+    }
+
+    private var saveButton: some View {
+        Button {
+            service.saveCurrent()
+        } label: {
+            HStack(spacing: 5) {
+                Image(systemName: "plus")
+                    .font(.system(size: 10, weight: .bold))
+                Text(strings.saveArrangement)
+                    .font(.system(size: 11, weight: .semibold))
+            }
+            .foregroundStyle(selectedTint)
+            .frame(maxWidth: .infinity)
+            .padding(.vertical, 7)
+            .contentShape(Rectangle())
+            .overlay(
+                RoundedRectangle(cornerRadius: 8, style: .continuous)
+                    .strokeBorder(selectedTint.opacity(0.45),
+                                  style: StrokeStyle(lineWidth: 1, dash: [3, 3]))
+            )
+        }
+        .buttonStyle(.plain)
+    }
+
+    /// An adaptive grid rather than a fixed number of columns: the strip has to
+    /// survive both the 308pt panel and a Dynamic Island sized down to its
+    /// 360pt minimum, where a hard-coded five per row overflows.
+    private var grid: some View {
+        LazyVGrid(columns: [GridItem(.adaptive(minimum: slotWidth, maximum: slotWidth),
+                                     spacing: 8, alignment: .leading)],
+                  alignment: .leading,
+                  spacing: 6) {
+            ForEach(service.presets) { preset in
+                thumbnail(preset)
+            }
+        }
+    }
+
+    private func thumbnail(_ preset: DisplayArrangementPreset) -> some View {
+        let applicable = DisplayArrangementSupport.matches(preset, connected: service.connectedKeys)
+        let isActive = service.activePresetID == preset.id
+        // The badge is a sibling of the button, not an overlay on it: a
+        // disabled button disables its own subtree, and the badge is shown
+        // in exactly the state that disables the button.
+        return ZStack(alignment: .topLeading) {
+            Button {
+                service.apply(preset)
+            } label: {
+                ArrangementThumbnail(slots: preset.slots,
+                                     tint: isActive ? selectedTint : Color.secondary,
+                                     mainKey: service.mainDisplayKey)
+                    .frame(width: 42, height: 28)
+                    .padding(4)
+                    .background(
+                        RoundedRectangle(cornerRadius: 8, style: .continuous)
+                            .fill(containerFill(isActive: isActive))
+                    )
+                    .contentShape(RoundedRectangle(cornerRadius: 8, style: .continuous))
+            }
+            .buttonStyle(.plain)
+            .disabled(editing || !applicable)
+            .opacity(applicable ? 1 : 0.4)
+            .accessibilityLabel(accessibilityLabel(preset, applicable: applicable, isActive: isActive))
+
+            if editing { deleteBadge(preset) }
+        }
+        // On the container, so the reason a preset is dimmed stays readable
+        // even though the button under it is disabled.
+        .help(tooltip(preset, applicable: applicable))
+    }
+
+    private func deleteBadge(_ preset: DisplayArrangementPreset) -> some View {
+        Button {
+            service.delete(preset.id)
+        } label: {
+            Image(systemName: "minus")
+                .font(.system(size: 8, weight: .black))
+                .foregroundStyle(badgeGlyph)
+                .frame(width: 14, height: 14)
+                .background(Circle().fill(badgeFill))
+                .contentShape(Circle())
+        }
+        .buttonStyle(.plain)
+        .offset(x: -3, y: -3)
+        .help(strings.deleteArrangement)
+        .accessibilityLabel(strings.deleteArrangement)
+    }
+
+    private func failureText(_ failure: DisplayArrangementService.Failure) -> some View {
+        Text(failureMessage(failure))
+            .font(.system(size: 10.5))
+            .foregroundStyle(failure == .applyFailed ? Color.red : Color.secondary)
+            .fixedSize(horizontal: false, vertical: true)
+    }
+
+    private func failureMessage(_ failure: DisplayArrangementService.Failure) -> String {
+        switch failure {
+        case .applyFailed: return strings.applyFailed
+        case .duplicate: return strings.duplicate
+        case .limitReached:
+            return String(format: strings.limitReached, DisplayArrangementSupport.maximumPresets)
+        }
+    }
+
+    // MARK: - Colors
+
+    /// The panel already has a rule for "this one is selected", and it drops
+    /// the accent entirely inside the Dynamic Island, where the whole surface
+    /// is monochrome on black. See `MenuPanelView.sectionNavigation` and
+    /// `navigationActiveFill`.
+    private var selectedTint: Color { notchPresentation ? .white : .accentColor }
+
+    private func containerFill(isActive: Bool) -> Color {
+        guard isActive else { return .clear }
+        if notchPresentation { return Color.white.opacity(0.12) }
+        return Color.accentColor.opacity(colorScheme == .light ? 0.13 : 0.20)
+    }
+
+    /// The badge reads as a solid dot against whatever it sits on, so it
+    /// inverts with the appearance. The Dynamic Island forces a dark scheme,
+    /// which is why checking the scheme alone covers it.
+    private var badgeFill: Color {
+        colorScheme == .dark ? Color.white.opacity(0.9) : Color.black.opacity(0.75)
+    }
+
+    private var badgeGlyph: Color {
+        colorScheme == .dark ? .black : .white
+    }
+
+    // MARK: - Describing a layout in words
+
+    private func tooltip(_ preset: DisplayArrangementPreset, applicable: Bool) -> String {
+        guard applicable else {
+            let missing = DisplayArrangementSupport.missingDisplayNames(
+                preset, connected: service.connectedKeys)
+            return String(format: strings.needsDisplays, missing.joined(separator: ", "))
+        }
+        return describe(preset)
+    }
+
+    private func accessibilityLabel(_ preset: DisplayArrangementPreset,
+                                    applicable: Bool,
+                                    isActive: Bool) -> String {
+        let base = tooltip(preset, applicable: applicable)
+        guard isActive else { return base }
+        return "\(base), \(strings.currentArrangement)"
+    }
+
+    /// Two displays, the case this exists for, get a spatial sentence. Beyond
+    /// that a relation to the main display stops describing the layout, so the
+    /// count is the honest answer.
+    private func describe(_ preset: DisplayArrangementPreset) -> String {
+        let fallback = String(format: strings.displayCount, preset.slots.count)
+        guard preset.slots.count == 2,
+              let main = DisplayArrangementSupport.mainSlot(preset.slots),
+              let other = DisplayArrangementSupport.describingSlot(preset) else { return fallback }
+        let format: String
+        switch DisplayArrangementSupport.relation(of: other, to: main) {
+        case .left: format = strings.relationLeft
+        case .right: format = strings.relationRight
+        case .above: format = strings.relationAbove
+        case .below: format = strings.relationBelow
+        case .overlapping: return fallback
+        }
+        return String(format: format, other.name, main.name)
+    }
+}
+
+/// Marks which display owns the menu bar, and moves it on click. Sits in the
+/// display's own row rather than in a switcher of its own, so the question
+/// "which one is main" is answered where the display is already named.
+struct MainDisplayStar: View {
+    @ObservedObject private var l10n = L10n.shared
+    @ObservedObject private var service = DisplayArrangementService.shared
+    @Environment(\.notchPresentation) private var notchPresentation
+    let display: BrightnessDisplay
+
+    private var strings: DisplayArrangementStrings {
+        FeatureStrings.displayArrangement(l10n.language)
+    }
+
+    private var isMain: Bool { service.mainDisplayID == display.id }
+    /// Exactly one display is always main, so this is a radio rather than a
+    /// checkbox: the starred row has nothing to toggle, and a display that is
+    /// switched off cannot hold a menu bar.
+    private var actionable: Bool { !isMain && display.isActive }
+
+    var body: some View {
+        Button {
+            // Refused here rather than with `.disabled`: a disabled button
+            // draws its label dimmed, and the filled star has to read at full
+            // strength to say which display is main.
+            guard actionable else { return }
+            service.makeMain(display.id)
+        } label: {
+            Image(systemName: isMain ? "star.fill" : "star")
+                .font(.system(size: 10, weight: .semibold))
+                .foregroundStyle(isMain ? AnyShapeStyle(notchPresentation ? Color.white
+                                                                          : Color.accentColor)
+                                        : AnyShapeStyle(.tertiary))
+                .frame(width: 16, height: 16)
+                .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .help(isMain ? strings.mainDisplay : strings.makeMainDisplay)
+        .accessibilityLabel(isMain ? strings.mainDisplay : strings.makeMainDisplay)
+    }
+}
+
+/// A saved arrangement drawn to scale: the displays as they sit, with the one
+/// holding the menu bar filled more strongly so its home is visible in a 42pt
+/// picture. The tint is the caller's, so the strip can spend the accent on the
+/// arrangement that is actually in use.
+struct ArrangementThumbnail: View {
+    let slots: [DisplaySlot]
+    let tint: Color
+    /// Where the menu bar lives *now*, not where it lived when this
+    /// arrangement was saved: applying one no longer moves it, so drawing the
+    /// saved main display would promise something that will not happen.
+    let mainKey: String?
+
+    var body: some View {
+        Canvas { context, size in
+            guard let box = DisplayArrangementSupport.boundingBox(slots) else { return }
+            let scale = min(size.width / box.width, size.height / box.height)
+            let originX = (size.width - box.width * scale) / 2
+            let originY = (size.height - box.height * scale) / 2
+            for slot in slots {
+                let rect = CGRect(x: originX + (Double(slot.x) - box.minX) * scale,
+                                  y: originY + (Double(slot.y) - box.minY) * scale,
+                                  width: Double(slot.width) * scale,
+                                  height: Double(slot.height) * scale)
+                    .insetBy(dx: 0.75, dy: 0.75)
+                guard rect.width > 0, rect.height > 0 else { continue }
+                let shape = Path(roundedRect: rect, cornerRadius: 1.5)
+                let carriesMenuBar = slot.key == mainKey
+                context.fill(shape, with: .color(tint.opacity(carriesMenuBar ? 0.55 : 0.24)))
+                context.stroke(shape, with: .color(tint.opacity(0.9)), lineWidth: 0.75)
+            }
+        }
+        .accessibilityHidden(true)
+    }
+}

+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Chlcony
+
+import AppKit
+import os
+
+/// Saved display arrangements, applied with one click from the Displays
+/// section. macOS keeps exactly one arrangement, so a person who works both
+/// with the laptop beside an external monitor and with it underneath has to
+/// redraw the layout in System Settings every time they switch. This
+/// remembers the layouts instead.
+///
+/// Everything here is public CoreGraphics: origins are read with
+/// `CGDisplayBounds` and written inside a `CGBeginDisplayConfiguration`
+/// transaction. The main display is the one at the origin, so origins alone
+/// carry both the layout and the menu bar's home.
+final class DisplayArrangementService: ObservableObject {
+    static let shared = DisplayArrangementService()
+
+    private static let log = Logger(subsystem: Bundle.main.bundleIdentifier ?? "vorssaint",
+                                    category: "display")
+
+    enum Failure: Equatable {
+        case applyFailed
+        case duplicate
+        case limitReached
+    }
+
+    @Published private(set) var presets: [DisplayArrangementPreset] = []
+    @Published private(set) var activePresetID: UUID?
+    @Published private(set) var connectedKeys: Set<String> = []
+    /// Which display currently owns the menu bar. Published rather than read
+    /// from CoreGraphics in a view body: asking the display server from a body
+    /// that may itself be laid out inside a reconfiguration is how issue #969
+    /// happened.
+    @Published private(set) var mainDisplayID: CGDirectDisplayID?
+    /// The same display as `mainDisplayID`, by the key presets are written in.
+    @Published private(set) var mainDisplayKey: String?
+    @Published private(set) var failure: Failure?
+
+    /// Saved arrangements, JSON `[DisplayArrangementPreset]`. Kept here rather
+    /// than in `DefaultsKey` so the feature stays in its own files; absent
+    /// means none saved, so there is no registered default.
+    static let presetsKey = "displayArrangementPresets"
+
+    private var refreshWork: DispatchWorkItem?
+    private var observing = false
+
+    /// Reading the saved presets is all the initializer does. The live
+    /// displays are read from `syncWithPreferences`, which the Displays section
+    /// calls when it appears: publishing a change from here would mean
+    /// publishing it while the view that asked for this singleton is still
+    /// being built.
+    private init() {
+        presets = DisplayArrangementSupport.decode(
+            UserDefaults.standard.data(forKey: Self.presetsKey))
+    }
+
+    /// v1 rides on the Brightness feature, because the strip lives inside that
+    /// section and cannot be reached when it is uninstalled. When arrangements
+    /// earn their own hub entry, this is the only line that changes.
+    static var isAvailable: Bool { AppFeature.brightness.isAvailable }
+
+    /// One display has no arrangement to speak of, so the strip stays out of
+    /// the way entirely until a second one is connected.
+    var isUsable: Bool { Self.isAvailable && connectedKeys.count > 1 }
+
+    func syncWithPreferences() {
+        guard Self.isAvailable else {
+            stopObserving()
+            return
+        }
+        startObserving()
+        refresh()
+    }
+
+    // MARK: - Reading the live arrangement
+
+    func refresh() {
+        guard Thread.isMainThread else {
+            DispatchQueue.main.async { [weak self] in self?.refresh() }
+            return
+        }
+        let current = Self.currentSlots()
+        connectedKeys = Set(current.map(\.key))
+        activePresetID = DisplayArrangementSupport.activePreset(in: presets, current: current)
+        mainDisplayID = NSScreen.screens.first { CGDisplayBounds($0.displayID).origin == .zero }?
+            .displayID
+        mainDisplayKey = current.first(where: \.isMain)?.key
+    }
+
+    /// The live arrangement, main thread only: `NSScreen` is main-thread work,
+    /// and it is also what gives each display the name System Settings shows.
+    private static func currentSlots() -> [DisplaySlot] {
+        guard Thread.isMainThread else { return [] }
+        var slots: [DisplaySlot] = []
+        for screen in NSScreen.screens {
+            let id = screen.displayID
+            guard id != 0 else { continue }
+            // A mirrored display shows another one's picture and has no place
+            // of its own; it follows its source wherever that goes.
+            guard CGDisplayMirrorsDisplay(id) == 0 else { continue }
+            guard let reference = CGDisplayCreateUUIDFromDisplayID(id)?.takeRetainedValue(),
+                  let key = CFUUIDCreateString(nil, reference) as String? else { continue }
+            let bounds = CGDisplayBounds(id)
+            slots.append(DisplaySlot(key: key,
+                                     name: screen.localizedName,
+                                     x: Int(bounds.origin.x),
+                                     y: Int(bounds.origin.y),
+                                     width: Int(bounds.width),
+                                     height: Int(bounds.height)))
+        }
+        return slots
+    }
+
+    // MARK: - Editing
+
+    func saveCurrent() {
+        guard Thread.isMainThread else { return }
+        let current = Self.currentSlots()
+        guard current.count > 1 else { return }
+        if let existing = DisplayArrangementSupport.duplicate(of: current, in: presets) {
+            failure = .duplicate
+            activePresetID = existing
+            return
+        }
+        guard presets.count < DisplayArrangementSupport.maximumPresets else {
+            failure = .limitReached
+            return
+        }
+        let preset = DisplayArrangementPreset(slots: current)
+        presets.append(preset)
+        persist()
+        failure = nil
+        activePresetID = preset.id
+    }
+
+    func delete(_ id: UUID) {
+        presets.removeAll { $0.id == id }
+        persist()
+        failure = nil
+        if activePresetID == id { activePresetID = nil }
+        refresh()
+    }
+
+    /// Dismisses a "already saved" or "that is the limit" notice. Leaving
+    /// edit mode is an answer to it, so the notice goes with it.
+    func clearFailure() {
+        failure = nil
+    }
+
+    private func persist() {
+        guard let data = DisplayArrangementSupport.encode(presets) else { return }
+        UserDefaults.standard.set(data, forKey: Self.presetsKey)
+    }
+
+    // MARK: - Applying
+
+    /// Moves every display to its saved origin inside one reconfiguration.
+    ///
+    /// **Main thread only**, for the reason spelled out on
+    /// `BrightnessService.configureDisplay`: CoreGraphics runs a
+    /// reconfiguration's callbacks inline on the driving thread, and in this
+    /// process those callbacks are AppKit's, which is main-thread work.
+    ///
+    /// The whole layout goes in one transaction so the display server resolves
+    /// it as a unit. Applying displays one at a time would make macOS close
+    /// the gaps after each move, and the arrangement would land somewhere the
+    /// user never saved.
+    /// Applying an arrangement moves the screens and leaves the menu bar where
+    /// the person put it. The stored origins carry whichever display was main
+    /// at save time, so they are re-anchored on the current one first; a preset
+    /// that does not contain the current main display is applied as saved,
+    /// since there is nothing to keep.
+    func apply(_ preset: DisplayArrangementPreset) {
+        guard let key = mainDisplayKey, preset.keys.contains(key),
+              let anchored = DisplayArrangementSupport.slots(preset.slots, keepingMain: key)
+        else {
+            place(preset.slots)
+            return
+        }
+        place(anchored)
+    }
+
+    /// Moves the menu bar to `target`, keeping every display where it is
+    /// relative to the others. macOS calls the display at the origin the main
+    /// one, so this is a translation of the whole arrangement rather than a
+    /// setting of its own.
+    func makeMain(_ target: CGDirectDisplayID) {
+        guard Thread.isMainThread else {
+            Self.log.error("refused to change the main display off the main thread")
+            return
+        }
+        let identifiers = SpaceWindowBridge.displayIDsByUUID()
+        guard let key = identifiers.first(where: { $0.value == target })?.key,
+              let moved = DisplayArrangementSupport.slots(Self.currentSlots(), makingMain: key)
+        else { return }
+        place(moved)
+    }
+
+    private func place(_ slots: [DisplaySlot]) {
+        guard Thread.isMainThread else {
+            Self.log.error("refused to reconfigure displays off the main thread")
+            return
+        }
+        let identifiers = SpaceWindowBridge.displayIDsByUUID()
+        var reference: CGDisplayConfigRef?
+        guard CGBeginDisplayConfiguration(&reference) == .success,
+              let configuration = reference else {
+            failure = .applyFailed
+            return
+        }
+        for slot in slots {
+            // `decode` refuses a preset whose origins are out of Int32 range,
+            // so clamping here is belt and braces rather than the guard: it
+            // means no future caller can turn a bad number into a trap.
+            guard let id = identifiers[slot.key],
+                  CGConfigureDisplayOrigin(configuration, id,
+                                           Int32(clamping: slot.x),
+                                           Int32(clamping: slot.y)) == .success else {
+                CGCancelDisplayConfiguration(configuration)
+                Self.log.error("could not place display \(slot.key, privacy: .public)")
+                failure = .applyFailed
+                return
+            }
+        }
+        // Permanent because that is what the person means by switching
+        // arrangement: System Settings writes the same way, and a layout that
+        // reverted on quit would be a worse answer than the manual dragging
+        // this replaces.
+        guard CGCompleteDisplayConfiguration(configuration, .permanently) == .success else {
+            Self.log.error("display reconfiguration was refused")
+            failure = .applyFailed
+            return
+        }
+        failure = nil
+        refresh()
+    }
+
+    // MARK: - Staying in step with the displays
+
+    private func startObserving() {
+        guard !observing else { return }
+        observing = true
+        NotificationCenter.default.addObserver(
+            self,
+            selector: #selector(screenParametersDidChange),
+            name: NSApplication.didChangeScreenParametersNotification,
+            object: nil)
+    }
+
+    private func stopObserving() {
+        guard observing else { return }
+        observing = false
+        NotificationCenter.default.removeObserver(
+            self, name: NSApplication.didChangeScreenParametersNotification, object: nil)
+    }
+
+    /// A single change arrives as a burst of notifications, and applying an
+    /// arrangement causes one itself, so the reread is coalesced.
+    @objc private func screenParametersDidChange() {
+        refreshWork?.cancel()
+        let work = DispatchWorkItem { [weak self] in
+            guard let self else { return }
+            self.refreshWork = nil
+            self.refresh()
+        }
+        refreshWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.1, execute: work)
+    }
+}

+++ b/Sources/Vorssaint/Services/Update/UpdateService.swift
@@ -129,6 +129,7 @@ final class UpdateService: ObservableObject {
 
         URLSession.shared.dataTask(with: request) { [weak self] data, _, error in
             guard let self else { return }
+            let castlingSupported = CastlingUpdates.supportedVersions()  // Castling: off the main thread
             DispatchQueue.main.async {
                 self.lastChecked = Date()
                 guard let data, error == nil else {
@@ -165,7 +166,7 @@ final class UpdateService: ObservableObject {
                 }
 
                 if let chosen = UpdateServiceSupport.selectUpdate(

#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Chlcony
#
# Builds Vorssaint with the Castling patch on this Mac and installs it.
#
#   ./install                  the version you have now, or the newest stable one
#   ./install 3.4.1            a specific Vorssaint version
#   ./install 3.4.2 --candidate 12   a version still under review, from pull request 12
#   ./install --restore        put back one of the saved backups, in seconds
#
# Never uses sudo. Backs up the current app first and restores it if anything
# fails, so you are never left without a working Vorssaint.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
app="/Applications/Vorssaint.app"
bundle_id="com.vorssaint.utils"
official_team="3D485NHW29"
upstream_url="https://github.com/vorssaint/vorssaint-utils.git"
state="$HOME/Library/Application Support/castling"

say()  { printf '%s\n' "$*"; }
step() { printf '\n▸ %s\n' "$*"; }
fail() { printf '\n✗ %s\n' "$*" >&2; exit 1; }

ask_yes() { # ask_yes "question" → true on yes; default yes; false without a terminal
    local reply
    [[ -t 0 ]] || return 1
    read -r -p "$1 [Y/n] " reply
    [[ -z "$reply" || "$reply" =~ ^[Yy] ]]
}

# --- arguments ---------------------------------------------------------------

# Kept whole for the restart after Castling updates itself, which happens after
# the loop below has consumed them.
args=("$@")
target=""
candidate=""
restore_pick=""
restoring=0
while (( $# )); do
    case "$1" in
        --candidate) candidate="${2:?--candidate needs a pull request number}"; shift ;;
        --restore)
            restoring=1
            if [[ -n "${2:-}" && "$2" != -* ]]; then restore_pick="$2"; shift; fi ;;
        -h|--help) sed -n '5,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) fail "Unknown option $1. Run ./install --help." ;;
        *) target="$1" ;;
    esac
    shift
done
[[ -z "$candidate" || "$candidate" =~ ^[0-9]+$ ]] || fail "--candidate takes a pull request number."

# One install at a time: the Update button and Terminal could otherwise build
# and swap the app at the same moment. mkdir is atomic; a lock left by a run
# that died is recognised by its process being gone.
mkdir -p "$state"
lock="$state/install.lock"
if ! mkdir "$lock" 2>/dev/null; then
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    # The restart after a self-update keeps this process id and its lock.
    if [[ "$holder" != "$$" ]] && [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
        fail "Another Castling install is already running (process $holder). Wait for it to finish."
    fi
    if [[ "$holder" != "$$" ]]; then rm -rf "$lock"; mkdir "$lock"; fi
fi
echo $$ >"$lock/pid"
cleanup() { rm -rf "$lock" "${work:-}"; }
trap cleanup EXIT

# --- restore a backup ----------------------------------------------------------

# Before the preflight on purpose: putting a saved app back needs no network
# and no developer tools.
if (( restoring )); then
    backups=()
    while IFS= read -r b; do backups+=("$b"); done < <(
        ls -1d "$state/backups"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-Vorssaint-*.app \
            2>/dev/null | sort -r)
    (( ${#backups[@]} )) || fail "There are no backups to restore."

    describe() { # describe <app> → "3.4.1, official" or "3.4.1, with Castling"
        local v kind
        v="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null || echo "?")"
        if codesign -dv "$1" 2>&1 | grep -q "TeamIdentifier=$official_team"; then kind="official"
        else kind="with Castling"; fi
        printf '%s, %s' "$v" "$kind"
    }

    if [[ -z "$restore_pick" ]]; then
        say "Backups, newest first:"
        for i in "${!backups[@]}"; do
            name="$(basename "${backups[$i]}")"
            stamp="${name:0:4}-${name:4:2}-${name:6:2} ${name:9:2}:${name:11:2}"
            printf '  %d. %s  (%s)\n' $((i + 1)) "$stamp" "$(describe "${backups[$i]}")"
        done
        [[ -t 0 ]] || fail "Run again with the number to restore, e.g. ./install --restore 1"
        read -r -p "Restore which one? " restore_pick
    fi
    [[ "$restore_pick" =~ ^[0-9]+$ ]] && (( restore_pick >= 1 && restore_pick <= ${#backups[@]} )) \
        || fail "Pick a number from 1 to ${#backups[@]}."
    chosen="${backups[$((restore_pick - 1))]}"

    step "Restoring $(basename "$chosen")"
    osascript -e "tell application id \"$bundle_id\" to quit" >/dev/null 2>&1 || true
    for _ in {1..50}; do pgrep -f "$app/Contents/MacOS/" >/dev/null || break; sleep 0.2; done
    pgrep -f "$app/Contents/MacOS/" >/dev/null && fail "Vorssaint is still running. Quit it and try again."
    if [[ -d "$app" ]]; then
        ditto "$app" "$state/backups/$(date +%Y%m%d-%H%M%S)-Vorssaint-$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null || echo unknown).app"
    fi
    rm -rf "$app"
    ditto "$chosen" "$app"
    open "$app"
    say "✓ Restored Vorssaint $(describe "$app"). The app you had is saved as the newest backup."
    say "  If this switched between the official app and a Castling build, macOS may"
    say "  need Accessibility and Screen Recording granted again."
    exit 0
fi

# --- 1. preflight ------------------------------------------------------------

[[ "$(uname -s)" == Darwin ]] || fail "Castling only runs on macOS."
major="$(sw_vers -productVersion | cut -d. -f1)"
(( major >= 14 )) || fail "Vorssaint needs macOS 14 or newer; this Mac has $(sw_vers -productVersion)."
[[ "$(uname -m)" == arm64 ]] || fail "Vorssaint needs an Apple Silicon Mac."
xcode-select -p >/dev/null 2>&1 \
    || fail "Apple's developer tools are missing. Run: xcode-select --install   then run ./install again."
for tool in git swiftc plutil codesign ditto python3; do
    command -v "$tool" >/dev/null || fail "$tool is missing. Run: xcode-select --install"
done

# --- keep Castling itself current ----------------------------------------

# Users update with this one command, so it fetches the newest Castling first
# and restarts as that version. git replaces files rather than rewriting them,
# so the copy running now is not disturbed.
if [[ -d "$here/.git" && "${CASTLING_UPDATED:-0}" != 1 ]]; then
    before="$(git -C "$here" rev-parse HEAD)"
    git -C "$here" pull --ff-only --quiet 2>"$here/.git/castling-pull.log" \
        || fail "Couldn't update Castling (see .git/castling-pull.log). If you changed
  files in $here, undo those changes and run this again. Nothing was changed."
    if [[ "$(git -C "$here" rev-parse HEAD)" != "$before" ]]; then
        say "Updated Castling."
        CASTLING_UPDATED=1 exec "$here/install" ${args[@]+"${args[@]}"}
    fi
fi

work="$(mktemp -d)"

# --- 2. where the patch comes from -------------------------------------------

src="$here"
allowed="supported"
if [[ -n "$candidate" ]]; then
    step "Fetching candidate from pull request $candidate"
    git -C "$here" fetch --quiet origin "pull/$candidate/head" \
        || fail "Could not fetch pull request $candidate."
    src="$work/candidate"
    mkdir -p "$src"
    git -C "$here" archive FETCH_HEAD | tar -x -C "$src"
    allowed="supported in-development"
fi

manifest="$src/supported.json"
[[ -f "$manifest" ]] || fail "supported.json is missing from $src."
field() { plutil -extract "releases.$1.$2" raw -o - "$manifest" 2>/dev/null || true; }
count="$(plutil -extract releases raw -o - "$manifest")"

# Oldest first. A beta sorts before its release (3.4.2-beta.1 < 3.4.2), which
# plain `sort -V` gets backwards; and the loop must not end on a failed test,
# which pipefail and set -e would turn into a silent exit.
supported_list() {
    local i
    for (( i = 0; i < count; i++ )); do
        if [[ "$(field "$i" status)" == supported ]]; then printf '%s\n' "$(field "$i" version)"; fi
    done | python3 -c '
import sys
def order(v):
    base, _, pre = v.partition("-")
    nums = tuple(int(n) for n in base.split(".") if n.isdigit())
    tail = tuple((0, int(n), "") if n.isdigit() else (1, 0, n) for n in pre.split(".")) if pre else ()
    return (nums, 0 if pre else 1, tail)
for v in sorted((l.strip() for l in sys.stdin if l.strip()), key=order):
    print(v)'
}

installed=""
[[ -d "$app" ]] && installed="$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' \
    "$app/Contents/Info.plist" 2>/dev/null || true)"

if [[ -z "$target" ]]; then
    if [[ -n "$installed" ]]; then target="$installed"
    # A fresh install gets the newest stable release; betas are opt-in,
    # through Vorssaint's own beta setting or by naming one.
    else target="$(supported_list | grep -v -- - | tail -1 || true)"
    fi
fi
[[ -n "$target" ]] || fail "No supported Vorssaint version is listed yet."

# --- 3. is this version supported? -------------------------------------------

entry=""
for (( i = 0; i < count; i++ )); do
    [[ "$(field "$i" version)" == "$target" ]] && entry="$i"
done
status=""
[[ -n "$entry" ]] && status="$(field "$entry" status)"

if [[ -z "$entry" || " $allowed " != *" $status "* ]]; then
    if [[ "$status" == in-development ]]; then
        say "Castling doesn't support Vorssaint $target yet; it's in development."
    else
        say "Castling doesn't support Vorssaint $target."
    fi
    say "Your current app is unchanged."
    newest="$(supported_list | grep -v -- - | tail -1 || true)"
    if [[ -n "$newest" ]]; then
        say ""
        say "Supported versions: $(supported_list | paste -sd ' ' -)"
        say "To install Vorssaint $newest with Castling: $0 $newest"
    fi
    exit 0
fi

commit="$(field "$entry" commit)"
patch="$(field "$entry" patch)"
# Versions whose patch carried over unchanged share one patch set.
set_name="$(field "$entry" patches)"
set_name="${set_name:-$target}"
patches="$src/patches/$set_name"
ls "$patches"/*.patch >/dev/null 2>&1 || fail "No patch files in patches/$set_name."

say "Installing Vorssaint $target with Castling ${patch:-candidate}."
[[ -n "$installed" ]] && say "Currently installed: Vorssaint $installed."

# --- 4. fetch upstream at the pinned commit ----------------------------------

step "Downloading Vorssaint $target"
git clone --quiet --depth 1 --branch "v$target" "$upstream_url" "$work/vorssaint" 2>/dev/null \
    || fail "Could not download Vorssaint $target from GitHub."
actual="$(git -C "$work/vorssaint" rev-parse HEAD)"
[[ "$actual" == "$commit" ]] || fail "Vorssaint's v$target tag now points at a different commit
  ($actual, expected $commit). Stopping rather than build unreviewed code.
  Nothing was changed."

# --- 5. patch, test, build ---------------------------------------------------

step "Applying the patch"
git -C "$work/vorssaint" -c user.name=Castling -c user.email=castling@localhost \
    am -3 --quiet "$patches"/*.patch >"$work/am.log" 2>&1 \
    || { cat "$work/am.log" >&2; fail "The patch did not apply. Nothing was changed."; }

step "Testing the patch"
"$src/tests/run" "$work/vorssaint" >"$work/tests.log" 2>&1 \
    || { cat "$work/tests.log" >&2; fail "The patch's tests failed. Nothing was changed."; }
tail -1 "$work/tests.log"

# --- 6. back up --------------------------------------------------------------

backup=""
was_official=0
if [[ -d "$app" ]]; then
    step "Backing up your current Vorssaint"
    codesign -dv "$app" 2>&1 | grep -q "TeamIdentifier=$official_team" && was_official=1
    mkdir -p "$state/backups"
    backup="$state/backups/$(date +%Y%m%d-%H%M%S)-Vorssaint-${installed:-unknown}.app"
    ditto "$app" "$backup"
    say "Saved to $backup"
fi

# Keep the three newest backups this script family made (date-stamped names);
# anything else in the folder belongs to the person and is left alone.
prune_backups() {
    local dir="$state/backups" old
    [[ -d "$dir" ]] || return 0
    ls -1d "$dir"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-Vorssaint-*.app 2>/dev/null \
        | sort -r | tail -n +4 | while IFS= read -r old; do rm -rf "$old"; done
}

restore() {
    if [[ -n "$backup" ]]; then
        say "Restoring your previous Vorssaint…" >&2
        rm -rf "$app"
        ditto "$backup" "$app"
        open "$app" 2>/dev/null || true
    fi
}

# --- 7. build and install ----------------------------------------------------

step "Building and installing (usually 3–5 minutes)"
if ! (cd "$work/vorssaint" && ./build.sh --install) >"$work/build.log" 2>&1; then
    tail -30 "$work/build.log" >&2
    # Most failures are compile errors, long before build.sh touches the
    # installed app; then there is nothing to put back.
    if grep -q "Installing into /Applications" "$work/build.log"; then
        restore
        fail "The build failed while installing. Your previous app is back in place."
    fi
    fail "The build failed. Your current app is unchanged."
fi
if ! "$app/Contents/MacOS/Vorssaint" --selftest 2>/dev/null | grep -q "SELFTEST OK"; then
    restore
    fail "The installed app failed its self-test. Your previous app is back in place."
fi
say "✓ Installed and self-tested"

# --- 8. permissions ----------------------------------------------------------

if (( was_official )); then
    say ""
    say "macOS treats this build as a new app, because you built and signed it"
    say "yourself. Permissions you gave the official app no longer apply, but"
    say "System Settings still shows them as granted, and no new prompt appears."
    say "They need clearing once and granting again. Later updates keep them."
    if ask_yes "Clear the old Accessibility and Screen Recording grants now?"; then
        tccutil reset Accessibility "$bundle_id" >/dev/null || true
        tccutil reset ScreenCapture "$bundle_id" >/dev/null || true
        say "Cleared. Vorssaint will ask again when it needs them, or turn it on in"
        say "System Settings › Privacy & Security › Accessibility, and under"
        say "Screen & System Audio Recording."
    else
        say "When you're ready:"
        say "  tccutil reset Accessibility $bundle_id"
        say "  tccutil reset ScreenCapture $bundle_id"
    fi
fi

# --- done --------------------------------------------------------------------

prune_backups
mkdir -p "$state"
# Vorssaint's Update button runs this installer from here (patch 02-update-hook).
printf '%s\n' "$here/install" >"$state/installer"
printf '{ "version": "%s", "patch": "%s", "installed": "%s" }\n' \
    "$target" "${patch:-candidate-$candidate}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$state/installed.json"

open "$app"
say ""
say "✓ Vorssaint $target with Castling is running."
say ""
say "When Castling supports a new Vorssaint, Vorssaint's own update banner"
say "offers it: click Update and Castling rebuilds the app for you."
say "To go back to the official app: $here/uninstall"
